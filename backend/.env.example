PORT=3000

# Опционально: ключ Gemini API (Google AI) для "живых" AI-ответов питомца,
# распознавания фото счётчиков и поиска характеристик приборов.
# Если не задан — используется встроенная rule-based логика (заглушка).
GEMINI_API_KEY=

# Секретный токен, которым подключённое устройство/счётчик должно подписывать свои запросы (простая защита)
DEVICE_TOKEN=change_me_please

# Секрет для подписи JWT-токенов авторизации (регистрация/вход).
# ОБЯЗАТЕЛЬНО задайте свой длинный случайный секрет в проде.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Секретный код для получения прав администратора в профиле (по умолчанию DIAWX7)
ADMIN_CODE=DIAWX7
