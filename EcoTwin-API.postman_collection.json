        {
          "name": "Add Reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"water\",\n  \"value\": 125.5,\n  \"unit\": \"liters\",\n  \"timestamp\": \"2026-08-19T10:30:00Z\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/readings",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "readings"]
            }
          }
        },
        {
          "name": "Get Readings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/readings?type=water&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "readings"],
              "query": [
                {
                  "key": "type",
                  "value": "water"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
